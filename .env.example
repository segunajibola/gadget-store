# Copy to .env.local and fill in. NEVER commit .env.local.
# Variables starting with NEXT_PUBLIC_ are sent to the browser — only put
# non-secret values there. Everything else stays on the server.

# --- Supabase (Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# SECRET — bypasses Row Level Security. Server only.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-or-secret-key

# --- Paystack (Dashboard → Settings → API Keys & Webhooks), use TEST keys first ---
# SECRET — also used to verify webhook signatures. Server only.
PAYSTACK_SECRET_KEY=sk_test_xxx
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_xxx

# --- Anthropic (Claude) — powers the laptop finder's AI suggestions ---
# SECRET. Create at https://console.anthropic.com → API Keys. Optional: without it
# the laptop finder still saves leads, it just doesn't show instant suggestions.
ANTHROPIC_API_KEY=

# --- Admin ---
# Comma-separated emails allowed into /admin (must also exist in Supabase Auth).
ADMIN_EMAILS=you@example.com

# --- Site ---
# Used for Paystack callback URLs and SEO. Set to your Vercel URL in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
